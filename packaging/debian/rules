#!/usr/bin/make -f

BUILD_TYPE   ?= RelWithDebInfo
APP_NAME      = Qt-App
BINARY_PKG    = qt-app
PACKET_DIR    = packaging/packet/deb
VERSION_FILE  = packaging/version.txt

%:
	dh $@ --buildsystem=cmake+ninja

# 版本号唯一来源 packaging/version.txt；debian/changelog 必须与之一致
override_dh_auto_configure:
	@ver_file=$$(cat $(VERSION_FILE)); \
	ver_changelog=$$(dpkg-parsechangelog -SVersion | sed 's/-[^-]*$$//'); \
	if [ "$$ver_file" != "$$ver_changelog" ]; then \
		echo "版本不一致：$(VERSION_FILE)=$$ver_file，debian/changelog=$$ver_changelog" >&2; \
		exit 1; \
	fi
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=$(BUILD_TYPE)

# 没有测试目标，跳过。
override_dh_auto_test:
	@echo "no test target, skipped"

# 组装完整可运行目录（主程序 + Qt 库 + 字体），不产出 AppImage / 7z
override_dh_auto_install:
	debian/package.sh

# 直接按 deb 布局落盘，省掉 debian/tmp 的二次拷贝
override_dh_install:
	install -d debian/$(BINARY_PKG)/opt
	cp -a $(PACKET_DIR) debian/$(BINARY_PKG)/opt/$(APP_NAME)
	install -Dm644 packaging/ubuntu/usr/share/applications/$(APP_NAME).desktop \
		debian/$(BINARY_PKG)/usr/share/applications/$(APP_NAME).desktop
	install -Dm644 src/resource/icon/app.png \
		debian/$(BINARY_PKG)/usr/share/icons/hicolor/1024x1024/apps/qt-app.png

# linuxdeployqt 输出的可执行文件经过 patchelf 修改，
# strip 可能破坏其 rpath 或 interpreter，因此跳过；dwz 同理。
override_dh_strip:
	@echo "Skipping dh_strip: binary pre-processed by linuxdeployqt"

override_dh_dwz:
	@echo "Skipping dh_dwz"
