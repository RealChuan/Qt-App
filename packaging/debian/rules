#!/usr/bin/make -f

# See debhelper(7) (uncomment to enable).
#export DH_VERBOSE = 1

BUILD_TYPE ?= RelWithDebInfo

APP_NAME = Qt-App
INSTALL_ROOT = /opt/$(APP_NAME)
PACKET_DIR = packaging/packet

%:
	dh $@ --buildsystem=cmake+ninja

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=$(BUILD_TYPE)

# 没有测试目标，跳过。
override_dh_auto_test:
	@echo "no test target, skipped"

# package.sh 生成 linuxdeployqt 的输出到 PACKET_DIR，
# 这里把它拷进 debian/tmp，再交给 dh_install 按 .install 文件布局。
override_dh_auto_install:
	debian/package.sh
	install -d debian/tmp$(INSTALL_ROOT)
	cp -a $(PACKET_DIR)/. debian/tmp$(INSTALL_ROOT)/
	dh_install

# linuxdeployqt 输出的可执行文件经过 patchelf 修改，
# strip 可能破坏其 rpath 或 interpreter，因此跳过。
# 如果确认不会出问题，可以删掉此 override 让 dh_strip 正常工作，
# 以获得更小的二进制体积。
override_dh_strip:
	@echo "Skipping dh_strip: binary pre-processed by linuxdeployqt"
	