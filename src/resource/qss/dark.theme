; 深色方案的令牌。强调色与资源里的 *-dark 图标同族（#5294E2），
; 不会出现两种蓝。注意：url() 必须带引号，否则 @2x 会让 QSS 解析失败。
;
; 深色下三层靠明度顺序区分：surface 比 window 亮、border 比 surface 亮，
; window 不用纯黑。具体比值见 light.theme 顶部，两套主题目标一致。

[colors]
window=#0B0E13
surface=#191D25
surfaceAlt=#232934
surfaceSunken=#2C333F
border=#313845
divider=#3B4351
borderStrong=#525D6F
text=#E8EBF1
textMuted=#A6AFBE
textSubtle=#8A93A2
textDisabled=#6B7583
accent=#5294E2
accentHover=#6AA5EB
accentPressed=#3F7FCC
accentText=#86B8F2
accentSoft=#1D2C40
accentSoftHover=#243553
onAccent=#0B1016
danger=#E87777
success=#53C894
tooltipBg=#232833
tooltipText=#E8EBF1
tooltipBorder=#414A59
scrollHandle=#414A59
scrollHandleHover=#556172

[icons]
checkUnchecked=url(":/controls/checkbox-unchecked-dark@2.png")
checkChecked=url(":/controls/checkbox-checked-selectionmode-dark@2.png")
checkPartial=url(":/controls/checkbox-mixed-dark@2.png")
checkDisabled=url(":/controls/checkbox-unchecked-insensitive-dark@2.png")
checkCheckedDisabled=url(":/controls/checkbox-checked-insensitive-dark@2.png")
checkPartialDisabled=url(":/controls/checkbox-mixed-insensitive-dark@2.png")
radioUnchecked=url(":/controls/radio-unchecked-dark@2.png")
radioChecked=url(":/controls/radio-checked-dark@2.png")
radioCheckedDisabled=url(":/controls/radio-checked-insensitive-dark@2.png")
arrowDown=url(":/controls/arrow-down-small.png")
arrowUp=url(":/controls/arrow-up-small.png")
branchClosed=url(":/controls/arrow-right.png")
branchOpen=url(":/controls/arrow-down.png")
