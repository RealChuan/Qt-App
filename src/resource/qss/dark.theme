; 深色方案的令牌。强调色与资源里的 *-dark 图标同族（#5294E2），
; 保证勾选框、单选框不会和按钮、选中态出现两种蓝。
; 注意：url() 必须带引号，否则文件名里的 @2x 会让 QSS 解析失败。

[colors]
window=#101216
surface=#171A20
surfaceAlt=#1E222A
surfaceSunken=#242932
border=#262C36
borderStrong=#39414E
text=#E7EAEF
textMuted=#A1AAB8
textSubtle=#6F7987
textDisabled=#5A636F
accent=#5294E2
accentHover=#6AA5EB
accentPressed=#3F7FCC
accentText=#7FB3F0
accentSoft=#1B2A3E
accentSoftHover=#22344C
onAccent=#0B1016
danger=#E26D6D
success=#4BC08A
tooltipBg=#22262E
tooltipText=#E7EAEF
scrollHandle=#3A424F
scrollHandleHover=#4C5666

[icons]
checkUnchecked=url(":/common/icon/common/checkbox-unchecked-dark@2.png")
checkChecked=url(":/common/icon/common/checkbox-checked-selectionmode-dark@2.png")
checkPartial=url(":/common/icon/common/checkbox-mixed-dark@2.png")
checkDisabled=url(":/common/icon/common/checkbox-unchecked-insensitive-dark@2.png")
checkCheckedDisabled=url(":/common/icon/common/checkbox-checked-insensitive-dark@2.png")
radioUnchecked=url(":/common/icon/common/radio-unchecked-dark@2.png")
radioChecked=url(":/common/icon/common/radio-checked-dark@2.png")
radioCheckedDisabled=url(":/common/icon/common/radio-checked-insensitive-dark@2.png")
arrowDown=url(":/common/icon/common/arrow-down-small.png")
arrowUp=url(":/common/icon/common/arrow-up-small.png")
branchClosed=url(":/common/icon/common/arrow-right.png")
branchOpen=url(":/common/icon/common/arrow-down.png")
