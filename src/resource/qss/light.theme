; 浅色方案的令牌。CSS 里只出现令牌占位符，由 Utils::Theme 在应用样式表前替换。
; 注意：url() 必须带引号。文件名里的 @2x 后缀会让 Qt 的 QSS 解析器直接报错。

[colors]
window=#F5F6F8
surface=#FFFFFF
surfaceAlt=#F2F4F7
surfaceSunken=#E9ECF1
border=#E3E7EE
borderStrong=#CCD3DE
text=#171A1F
textMuted=#5F6875
textSubtle=#98A1AE
textDisabled=#B7BFCB
accent=#0E6BFF
accentHover=#0B5BE0
accentPressed=#0A4CC0
accentText=#0B57D0
accentSoft=#E8F0FF
accentSoftHover=#DBE8FF
onAccent=#FFFFFF
danger=#D14343
success=#1E9A62
tooltipBg=#1B1F26
tooltipText=#F3F5F8
scrollHandle=#C7CFDA
scrollHandleHover=#AFB9C7

[icons]
checkUnchecked=url(":/common/icon/common/checkbox-unchecked@2.png")
checkChecked=url(":/common/icon/common/checkbox-checked-selectionmode@2.png")
checkPartial=url(":/common/icon/common/checkbox-mixed@2.png")
checkDisabled=url(":/common/icon/common/checkbox-unchecked-insensitive@2.png")
checkCheckedDisabled=url(":/common/icon/common/checkbox-checked-insensitive@2.png")
radioUnchecked=url(":/common/icon/common/radio-unchecked@2.png")
radioChecked=url(":/common/icon/common/radio-checked@2.png")
radioCheckedDisabled=url(":/common/icon/common/radio-checked-insensitive@2.png")
arrowDown=url(":/common/icon/common/arrow-down-small.png")
arrowUp=url(":/common/icon/common/arrow-up-small.png")
branchClosed=url(":/common/icon/common/arrow-right.png")
branchOpen=url(":/common/icon/common/arrow-down.png")
